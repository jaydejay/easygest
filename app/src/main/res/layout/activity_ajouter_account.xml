<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vue.AjouterAccountActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:foregroundGravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:id="@+id/ajoutacctitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textSize="15sp"
                android:textAllCaps="true"
                android:text="@string/ajouter_un_account"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/ajoutaccclientref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:layout_gravity="center_horizontal"
                android:textStyle="bold"
            />

            <Spinner
                android:id="@+id/spinnerajoutaccountArticle1"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:id="@+id/llayoutajoutaccarticle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
            >

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tl_ajoutaccarticle1prix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ajoutaccarticle1prix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="200dp"
                        android:autofillHints="@string/prix_article1"
                        android:ems="10"
                        android:gravity="center_horizontal|center_vertical"
                        android:hint="@string/prix_article1"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tl_ajoutaccNbrarticle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ajoutaccNbrarticle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="50dp"
                        android:autofillHints="@string/quantite1"
                        android:ems="10"
                        android:hint="@string/quantite1"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerajoutaccountArticle2"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
            >

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tl_ajoutaccarticle2prix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ajoutaccarticle2prix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="200dp"
                        android:autofillHints="@string/prix_article2"
                        android:ems="10"
                        android:gravity="center_horizontal|center_vertical"
                        android:hint="@string/prix_article2"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tl_ajoutaccNbrarticle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ajoutaccNbrarticle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="50dp"
                        android:autofillHints="@string/quantite2"
                        android:ems="10"
                        android:hint="@string/quantite2"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tl_ajoutaccDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
            >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ajoutaccDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="250dp"
                    android:autofillHints="@string/date"
                    android:ems="10"
                    android:gravity="center_horizontal|center_vertical"
                    android:hint="@string/date"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tl_ajoutaccversement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
            >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ajoutaccversement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="250dp"
                    android:autofillHints="@string/versement"
                    android:ems="10"
                    android:gravity="center_horizontal|center_vertical"
                    android:hint="@string/versement"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnajoutaccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/ajouter" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>