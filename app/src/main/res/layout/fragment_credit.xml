<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="5dp"
    android:paddingTop="10dp"
    android:paddingRight="5dp"
    android:paddingBottom="0dp"
    tools:context=".vue.ui.credit.CreditFragment">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:gravity="center_horizontal"
                            android:text="@string/enregistrer_un_credit"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreernom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreernom"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="180dp"
                                            android:autofillHints="@string/nom_client"
                                            android:ems="10"
                                            android:gravity="center_horizontal|center_vertical"
                                            android:hint="@string/nom_client"
                                            android:inputType="textPersonName"
                                            android:maxLength="20" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:id="@+id/txtcreercodeclt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="70dp"
                                    android:gravity="center" />

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tl_edittxtcreerprenoms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_gravity="center_horizontal">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edittxtcreerprenoms"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:autofillHints="@string/prenoms"
                                    android:minWidth="250dp"
                                    android:ems="10"
                                    android:gravity="center_horizontal|center_vertical"
                                    android:hint="@string/prenoms_client"
                                    android:inputType="textPersonName"
                                    android:maxWidth="488dp"
                                    android:maxLength="20" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Spinner
                            android:id="@+id/spinnerArticle1"
                            android:layout_width="wrap_content"
                            android:minWidth="250dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="25dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:spinnerMode="dropdown" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center_horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreerarticle1prix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreerarticle1prix"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="200dp"
                                            android:autofillHints="@string/prix_article1"
                                            android:ems="10"
                                            android:gravity="center_horizontal|center_vertical"
                                            android:hint="@string/prix_article1"
                                            android:inputType="number" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreerNbrarticle1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreerNbrarticle1"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="50dp"
                                            android:autofillHints="@string/quantite1"
                                            android:ems="10"
                                            android:hint="@string/quantite1"
                                            android:inputType="number" />
                                </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spinnerArticle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="250dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="25dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:spinnerMode="dropdown" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center_horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreerarticle2prix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreerarticle2prix"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="200dp"
                                            android:autofillHints="@string/prix_article2"
                                            android:ems="10"
                                            android:gravity="center_horizontal|center_vertical"
                                            android:hint="@string/prix_article2"
                                            android:inputType="number" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreerNbrarticle2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreerNbrarticle2"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="50dp"
                                            android:autofillHints="@string/quantite2"
                                            android:ems="10"
                                            android:hint="@string/quantite2"
                                            android:inputType="number" />
                                </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tl_editTextDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="250dp"
                                    android:autofillHints="@string/date_credit"
                                    android:ems="10"
                                    android:gravity="center_horizontal|center_vertical"
                                    android:hint="@string/date_credit"
                                    android:inputType="textPersonName" />
                        </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tl_edittxtcreerversement"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/edittxtcreerversement"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:minWidth="250dp"
                                            android:autofillHints="@string/versement"
                                            android:ems="10"
                                            android:gravity="center_horizontal|center_vertical"
                                            android:hint="@string/versement"
                                            android:inputType="number" />
                                </com.google.android.material.textfield.TextInputLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tl_edittxtcreertelephone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edittxtcreertelephone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="250dp"
                                    android:gravity="center"
                                    android:autofillHints="@string/telephone"
                                    android:ems="10"
                                    android:hint="@string/telephone"
                                    android:inputType="phone"
                                    android:maxLength="10" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <Button
                            android:id="@+id/btncreercredit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/enregistrer" />

                </LinearLayout>
        </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>