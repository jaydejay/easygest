<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vue.ActiverProduitActivity">

    <TextView
        android:id="@+id/txt_msg_expired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="@color/red"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/lleditativerproduit_appowner"
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="10dp"
        android:autofillHints="@string/app_owner"
        android:inputType="textPersonName"
        app:counterEnabled="true"
        app:counterMaxLength="25"
        app:endIconMode="clear_text"
        app:errorEnabled="true"
        app:helperText="@string/app_owner"
        app:helperTextEnabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_msg_expired">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editactiverproduitAppowner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/le_propritaire"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/lleditativerproduit_appnuber"
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:hint="@string/appnumber"
        android:inputType="textPersonName"
        app:counterEnabled="true"
        app:counterMaxLength="4"
        app:endIconMode="clear_text"
        app:errorEnabled="true"
        app:helperText="@string/helper_text"
        app:helperTextEnabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lleditativerproduit_appowner">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editactiverproduit_appnuber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_editactiverproduitAppKey"
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lleditativerproduit_appnuber">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editactiverproduitAppKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="@string/appkey"
            android:ems="10"
            android:gravity="center"
            android:hint="@string/appkey"
            android:inputType="textPersonName"
            android:maxLength="17" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnactiverproduit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valider"
        app:cornerRadius="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tl_editactiverproduitAppKey"/>

    <TextView
        android:id="@+id/txtCompte_free"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="@string/free_compte"
        android:textColor="@color/design_default_color_primary_dark"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnactiverproduit"/>


</androidx.constraintlayout.widget.ConstraintLayout>